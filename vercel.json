{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["iad1"],
  "env": {
    "NODE_ENV": "production"
  },
  "rewrites": [
    {
      "source": "/platform",
      "destination": "https://shamal-fh2-middleware.vercel.app/"
    },
    {
      "source": "/platform/:path*",
      "destination": "https://shamal-fh2-middleware.vercel.app/:path*"
    },
    {
      "source": "/v1/marafiq/:path*",
      "destination": "https://shamal-fh2-middleware.vercel.app/v1/marafiq/:path*"
    },
    {
      "source": "/webhooks/fh2",
      "destination": "https://shamal-fh2-middleware.vercel.app/webhooks/fh2"
    },
    {
      "source": "/health",
      "destination": "https://shamal-fh2-middleware.vercel.app/health"
    },
    {
      "source": "/api/:path*",
      "destination": "https://shamal-fh2-middleware.vercel.app/:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/backup/cron",
      "schedule": "0 4 * * *"
    }
  ]
}
