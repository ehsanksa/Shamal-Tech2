{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["iad1"],
  "env": {
    "NODE_ENV": "production"
  },
  "crons": [
    {
      "path": "/api/backup/cron",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/procurement/domain-expiry-cron",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/indexnow",
      "schedule": "0 6 * * *"
    }
  ]
}
