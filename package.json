{
  "name": "mysite",
  "version": "1.0.0",
  "description": "Website template for Payload",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "NODE_OPTIONS=--no-deprecation next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --experimental-https",
    "clean": "rm -rf .next",
    "dev:clean": "npm run clean && cross-env NODE_OPTIONS=--no-deprecation next dev --experimental-https",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation next lint --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed-db.ts",
    "sync:keywords": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/sync-seo-keywords.ts",
    "sync:products": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/sync-products.ts",
    "sync:training-interest-clickup": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/sync-training-interest-clickup.ts",
    "setup:procurement-clickup": "node scripts/setup-procurement-clickup.mjs",
    "publish:services": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/publish-services.ts",
    "test:db": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/test-db-connection.ts",
    "reset:password": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/reset-admin-password.ts",
    "clear:users": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/clear-all-users.ts",
    "backup:mongo": "bash scripts/mongo-dump-local.sh",
    "backup:content": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/backup-content.ts",
    "test:s3": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/test-s3-connection.ts",
    "fix:posts-meta": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/fix-posts-meta.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" pnpm exec playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1037.0",
    "@aws-sdk/lib-storage": "^3.1037.0",
    "@aws-sdk/s3-request-presigner": "^3.1037.0",
    "@maizzle/framework": "^5.3.1",
    "@payloadcms/admin-bar": "3.88.0",
    "@payloadcms/db-mongodb": "3.88.0",
    "@payloadcms/email-nodemailer": "3.88.0",
    "@payloadcms/live-preview-react": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/plugin-form-builder": "3.88.0",
    "@payloadcms/plugin-nested-docs": "3.88.0",
    "@payloadcms/plugin-redirects": "3.88.0",
    "@payloadcms/plugin-search": "3.88.0",
    "@payloadcms/plugin-seo": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-s3": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/typography": "^0.5.13",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "19.2.1",
    "animejs": "^4.3.6",
    "archiver": "^7.0.1",
    "autoprefixer": "^10.4.23",
    "bcryptjs": "^3.0.3",
    "bson": "^6.10.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dotenv": "16.4.7",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.43.0",
    "geist": "^1.3.0",
    "graphql": "^16.8.2",
    "gsap": "^3.14.2",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.2",
    "jspdf": "^4.2.1",
    "lenis": "^1.3.16",
    "lucide-react": "^0.378.0",
    "next": "15.4.11",
    "next-sitemap": "^4.2.3",
    "nodemailer": "^9.0.5",
    "payload": "3.88.0",
    "postcss": "^8.5.26",
    "pptxgenjs": "^4.0.1",
    "prism-react-renderer": "^2.3.1",
    "qrcode": "^1.5.4",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-hook-form": "7.45.4",
    "sharp": "0.35.3",
    "stripe": "^22.0.0",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.7.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "1.56.1",
    "@testing-library/react": "16.3.0",
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/escape-html": "^1.0.2",
    "@types/node": "22.5.4",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "4.5.2",
    "copyfiles": "^2.4.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.4.11",
    "jsdom": "26.1.0",
    "playwright": "1.56.1",
    "playwright-core": "1.56.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.21.0",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.7"
  },
  "overrides": {
    "nodemailer": "$nodemailer",
    "postcss": "$postcss",
    "sharp": "$sharp",
    "vite": "7.3.6",
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
