# MongoDB (Payload CMS). Use Atlas in production / on Vercel.
# MONGODB_URI=mongodb://127.0.0.1:27017/shamal-payload
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname?retryWrites=true&w=majority
# Optional alias:
# DATABASE_URI=mongodb+srv://...
MONGODB_URI=mongodb://127.0.0.1:27017/shamal-payload

# Never set in production unless you intend to wipe the CMS: allows destructive seed + /next/seed.
# ALLOW_DANGEROUS_SEED=true
# Rare: show the admin “Seed your database” button on production (still requires ALLOW_DANGEROUS_SEED to run).
# NEXT_PUBLIC_SHOW_ADMIN_SEED_BUTTON=true

# Local BSON dump (requires `mongodump` on PATH): pnpm backup:mongo
# Output: ./backup/mongo-dump-<UTC-time>/

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=https://localhost:3000

# Secret used to authenticate cron jobs (required for daily /api/backup/cron on Vercel)
CRON_SECRET=YOUR_CRON_SECRET_HERE

# --- AWS S3 (media uploads + admin Backup & Recovery Center) ---
# Required for Payload media on Vercel and for automated backups to database-backups/
# S3_BUCKET=your-bucket-name
# S3_ACCESS_KEY_ID=your-access-key-id
# S3_SECRET_ACCESS_KEY=your-secret-access-key
# S3_REGION=me-central-1
# Optional media prefix (defaults to "media"); backups always use database-backups/ at bucket root
# S3_PREFIX=media

# Optional: auth for /api/revalidate (cache clear). If unset, CRON_SECRET is used.
# REVALIDATE_SECRET=YOUR_REVALIDATE_SECRET_HERE

# Optional: dedicated secret for POST /api/seo/sync-keywords (bulk SEO from public/keywords.txt).
# If unset, REVALIDATE_SECRET or CRON_SECRET is used (same pattern as /api/revalidate).
# SEO_SYNC_SECRET=YOUR_SEO_SYNC_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE
# Microsoft 365: smtp.office365.com, port 587, SMTP_SECURE=false
# M365 admin must enable Authenticated SMTP for the mailbox (Security Defaults blocks basic auth otherwise).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Shamal Technologies
# Skip SMTP verify on serverless cold starts (recommended on Vercel). Set false only to test credentials locally.
SMTP_SKIP_VERIFY=true
CONTACT_EMAIL=
CONTACT_PHONE=
# Site-wide maintenance: 503 for all pages + APIs, static HTML (no MongoDB via HTTP).
# Restart dev server after changing. If middleware still ignores it, set NEXT_PUBLIC_MAINTENANCE_MODE=true.
MAINTENANCE_MODE=false
# NEXT_PUBLIC_MAINTENANCE_MODE=false
# Retry-After header (seconds). Default 3600.
MAINTENANCE_RETRY_AFTER=3600
# Optional: WhatsApp number for maintenance CTAs (digits only, e.g. 971501234567). Falls back to digits from CONTACT_PHONE.
MAINTENANCE_WHATSAPP_NUMBER=
SEED_DATABASE=

# Employee QR Profile System
# Profile images and company PDFs use the Media collection (S3 when configured)
# No additional env vars required - uses NEXT_PUBLIC_SERVER_URL for profile URLs

# ClickUp API token — one workspace for contact form, product quote cart, and training
CLICKUP_API_TOKEN=
# Sales pipeline list (contact + product quote RFQ tasks land here)
CLICKUP_LIST_ID=
# Auto-assign ClickUp tasks (emails resolved via GET /team; or set user IDs directly)
# CLICKUP_ASSIGNEE_CONTACT_EMAIL=r.mohammed@shamal.sa
# CLICKUP_ASSIGNEE_QUOTE_EMAIL=k.shami@shamal.sa
# Numeric ClickUp user IDs (recommended — email lookup is fallback)
# CLICKUP_ASSIGNEE_CONTACT_USER_ID=
# CLICKUP_ASSIGNEE_QUOTE_USER_ID=
# Calendar day for ClickUp due date (default Asia/Riyadh — always shows "Today" on submit)
# CLICKUP_TASK_TIMEZONE=Asia/Riyadh

# --- Shamal Training Platform (/training) ---
# Three ClickUp Lists: each task is a row; add custom fields to each list (names must match defaults or TRAINING_CLICKUP_FIELD_*).
TRAINING_CLICKUP_USERS_LIST_ID=
TRAINING_CLICKUP_PROGRESS_LIST_ID=
TRAINING_CLICKUP_PAYMENTS_LIST_ID=
# Optional: override custom field labels if yours differ from Email, Name, Role, Password_Hash, Warm_Lead, user_email, course_id, etc.
# TRAINING_CLICKUP_FIELD_EMAIL=
# TRAINING_CLICKUP_FIELD_NAME=
# TRAINING_CLICKUP_FIELD_PAYMENT_CREATED=created_at
# JWT for training sessions (separate from Payload)
TRAINING_JWT_SECRET=
# Stripe (Checkout + webhook at /api/training/webhooks/stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=
# Vimeo API token for resolving private embed URLs (optional; public fallback if unset)
VIMEO_ACCESS_TOKEN=

# --- Product Quote Cart (uses CLICKUP_* above + WhatsApp below) ---
# Meta WhatsApp Cloud API — alerts sales team on new RFQ
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0
# Recipient digits only (country code, no +), e.g. 966530301370
# SALES_TEAM_WHATSAPP_NUMBER=

# --- Optional: STC Pay hosted checkout (payment links sent by sales after proposal approval) ---
# STC_PAYMENT_ENV=sandbox
# STC_PAYMENT_MERCHANT_IDENTIFIER=
# STC_PAYMENT_ACCESS_CODE=
# STC_PAYMENT_SHA_REQUEST_PHRASE=
# STC_PAYMENT_SHA_RESPONSE_PHRASE=